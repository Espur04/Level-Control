<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Level_Control</AssemblyName>
    <RootNamespace>Level_Control</RootNamespace>
    <Configurations>Debug;Release</Configurations>
    <PublishConfigurationPath>Resources\PublishConfiguration.xml</PublishConfigurationPath>
  </PropertyGroup>

  <Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.props" />
  <Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.targets" />

  <ItemGroup>
    <Reference Include="Game">
      <Private>false</Private>
    </Reference>
    <Reference Include="Colossal.Core">
      <Private>false</Private>
    </Reference>
    <Reference Include="Colossal.Mathematics">
      <Private>false</Private>
    </Reference>
    <Reference Include="Colossal.Logging">
      <Private>false</Private>
    </Reference>
    <Reference Include="Colossal.IO.AssetDatabase">
      <Private>false</Private>
    </Reference>
    <Reference Include="Colossal.UI">
      <Private>false</Private>
    </Reference>
    <Reference Include="Colossal.UI.Binding">
      <Private>false</Private>
    </Reference>
    <Reference Include="Colossal.Localization">
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Collections">
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Entities">
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Mathematics">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="BuildUI" BeforeTargets="BeforeBuild">
    <Exec Command="npm run build" WorkingDirectory="$(ProjectDir)UI" />
  </Target>

  <Target Name="CopyUIAssets" AfterTargets="AfterBuild" BeforeTargets="DeployWIP">
    <ItemGroup>
      <UIBuildFiles Include="$(ProjectDir)UI\build\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(UIBuildFiles)" DestinationFiles="@(UIBuildFiles->'$(OutDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="$(ProjectDir)UI\mod.json" DestinationFolder="$(OutDir)" />
  </Target>
</Project>
